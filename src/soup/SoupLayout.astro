---
import { soupLocales, localePath } from './locales'
import { etchInitScript } from '../lib/etch'
import { themeInitScript } from './themes/SoupThemePicker'
import '../styles.css'
import '../i18n/international.css'
import './soup.css'
const { language = 'en', path = '', title, description, alternates = Object.keys(soupLocales) } = Astro.props
const canonical = `https://trysoup.dev${localePath(language)}${path}`
---
<!doctype html>
<html lang={language} dir={soupLocales[language].direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline set:html={themeInitScript} />
    {path === '' && <script is:inline set:html={etchInitScript} />}
    <link rel="icon" href="/soup/logo.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {alternates.map((code: string) => <link rel="alternate" hreflang={code} href={`https://trysoup.dev${localePath(code)}${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`https://trysoup.dev/${path}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soup" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://trysoup.dev/soup/social.png" />
  </head>
  <body><slot /></body>
</html>
